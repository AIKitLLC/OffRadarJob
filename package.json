{
  "name": "off-radar-job-gatherer",
  "version": "1.0.0",
  "description": "Decoupled asynchronous agent pipeline for gathering jobs from micro-companies on Cloudflare",
  "license": "MIT",
  "author": "AIKit LLC & Tuan Nguyen <tuannx87@gmail.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/AIKitLLC/OffRadarJob.git"
  },
  "main": "src/index.ts",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "demo": "tsx src/demo/local-runner.ts",
    "feed:continuous": "tsx src/scripts/continuous-batch-feeder.ts",
    "harvest:public": "tsx src/scripts/harvest-public-sources.ts",
    "harvest:newgrad": "tsx src/scripts/harvest-newgrad.ts",
    "cf-db:init": "wrangler d1 execute DB --local --file=migrations/0001_initial_schema.sql"
  },
  "dependencies": {
    "cheerio": "^1.0.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260903.1",
    "@types/node": "^22.13.5",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^3.0.7",
    "wrangler": "^4.129.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
