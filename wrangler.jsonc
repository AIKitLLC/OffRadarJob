{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "off-radar-jobs",
  "account_id": "05130ca1f0bdabbab4d08a5d75544e92",
  "main": "src/index.ts",
  "compatibility_date": "2025-02-24",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "routes": [
    {
      "pattern": "jobs.ai-kit.net",
      "custom_domain": true
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "off_radar_db",
      "database_id": "884e70ab-0716-4303-bbfd-3e0d4d1a6571",
      "migrations_dir": "migrations"
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "kv_namespaces": [
    {
      "binding": "CACHE",
      "id": "4234513ec026494da79d9e0b02542c3b"
    }
  ],
  "queues": {
    "producers": [
      { "binding": "DISCOVERY_QUEUE", "queue": "discovery-queue" },
      { "binding": "PROFILE_QUEUE", "queue": "profile-queue" },
      { "binding": "HUNT_QUEUE", "queue": "career-hunt-queue" },
      { "binding": "EXTRACT_QUEUE", "queue": "job-extract-queue" },
      { "binding": "DLQ", "queue": "off-radar-dlq" }
    ],
    "consumers": [
      {
        "queue": "discovery-queue",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 3,
        "dead_letter_queue": "off-radar-dlq"
      },
      {
        "queue": "profile-queue",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 3,
        "dead_letter_queue": "off-radar-dlq"
      },
      {
        "queue": "career-hunt-queue",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 3,
        "dead_letter_queue": "off-radar-dlq"
      },
      {
        "queue": "job-extract-queue",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 3,
        "dead_letter_queue": "off-radar-dlq"
      }
    ]
  },
  "vars": {
    "TELEGRAM_BOT_USERNAME": "OffRadarJobBot",
    "TELEGRAM_ADMIN_USERNAMES": "tuannx87",
  },
  "triggers": {
    "crons": [
      "0 2,8,14,20 * * *",
      "0 3 * * 1"
    ]
  }
}
